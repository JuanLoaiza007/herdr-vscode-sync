# =========================================================================
# herdr-vscode-sync — configuration (portable).
# No machine-specific paths allowed here. Everything resolves at runtime.
# Edit to taste; values below are the defaults.
# =========================================================================

# EXCLUDE_LABELS: comma-separated workspace LABEL patterns (case-insensitive
# substring match). Workspaces whose label matches any pattern are NOT
# mirrored into VS Code. Keeps non-project pseudo-workspaces (for example a
# "Desktop" workspace tracking the whole desktop folder) out of the editor.
EXCLUDE_LABELS="desktop,escritorio"

# WORKSPACE_FILE_NAME: file name (inside the herdr-managed plugin state dir)
# of the multi-root workspace stub VS Code opens. The extension fills its
# folder list live; this file's folder list stays empty on disk.
WORKSPACE_FILE_NAME="herdr.code-workspace"

# STATE_FILE_NAME: file name (inside the herdr-managed plugin state dir) of
# the folder list the VS Code extension watches and applies.
STATE_FILE_NAME="folders.json"
