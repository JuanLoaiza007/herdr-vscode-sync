# =========================================================================
# herdr-vscode-sync — configuration (portable).
# No machine-specific paths allowed here. Everything resolves at runtime.
# =========================================================================

# CURRENT_FILE_NAME: file (inside the herdr-managed plugin state dir) holding
# the followed herdr workspace: {"path": "...", "name": "..."}. The VS Code
# extension watches it and switches the anchor window's folder when Herdr
# focuses a different workspace.
CURRENT_FILE_NAME="current.json"

# WORKSPACE_FILE_NAME: single-folder workspace file (inside the herdr-managed
# plugin state dir) that `code <file>` opens. Opening the same file every time
# gives a stable anchor window; the extension swaps its folder on follow.
WORKSPACE_FILE_NAME="herdr.code-workspace"
